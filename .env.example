# ==============================================================================
# STARX LABS — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Public Application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Public Keys (Required for client-side queries)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Server-Only Service Role Key (NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# STARX Ecosystem Linkage
NEXT_PUBLIC_STARX_FLOW_URL=https://flow.starx.io
NEXT_PUBLIC_STARX_ECOSYSTEM_ENABLED=true
