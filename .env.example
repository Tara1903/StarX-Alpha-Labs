# ==============================================================================
# STARX ALPHA LABS — ENVIRONMENT CONFIGURATION (PHASE 5 BACKEND & CMS)
# ==============================================================================

# Public Application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Dedicated StarX Alpha Labs Supabase Infrastructure
# (CRITICAL: NEVER connect to or reuse STARX FLOW's Supabase project credentials)
NEXT_PUBLIC_SUPABASE_URL=https://your-labs-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-labs-anon-key-here

# Supabase Server-Only Service Role Key (NEVER expose to client, NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-labs-service-role-key-here

# Administrative Security & Initial Owner Bootstrap Secret
# (Used strictly in server-side bootstrap authorization)
STARX_BOOTSTRAP_SECRET=your-secure-random-bootstrap-secret-here

# STARX Ecosystem Linkage (Strictly decoupled, external referral links only)
NEXT_PUBLIC_STARX_FLOW_URL=https://starx-flow.runs-on.dev/
NEXT_PUBLIC_STARX_ECOSYSTEM_ENABLED=true
