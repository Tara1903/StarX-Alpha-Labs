# ==============================================================================
# STARX ALPHA LABS — GOOGLE STITCH WORKER SYSTEMD SERVICE UNIT
# Installation:
#   sudo cp systemd/starx-stitch-worker.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable starx-stitch-worker
#   sudo systemctl start starx-stitch-worker
#   sudo journalctl -u starx-stitch-worker -f
# ==============================================================================

[Unit]
Description=StarX Alpha Labs Google Stitch MCP Queue Worker Daemon
After=network.target

[Service]
Type=simple
User=node
WorkingDirectory=/var/www/starx-alpha-labs
ExecStart=/usr/bin/node scripts/stitch-worker.mjs
Restart=always
RestartSec=10
EnvironmentFile=/var/www/starx-alpha-labs/.env.local
Environment=NODE_ENV=production
Environment=STITCH_JOB_LEASE_MS=600000
Environment=STITCH_MAX_RETRIES=3

# Resource limitations
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal
SyslogIdentifier=starx-stitch-worker

[Install]
WantedBy=multi-user.target
